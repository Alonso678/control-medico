{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "mvn -B -DskipTests clean install -Pdes"
  },
  "deploy": {
    "startCommand": "java -Dserver.port=${PORT:-8080} -jar target/controlmedico-0.0.1-SNAPSHOT.jar",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}